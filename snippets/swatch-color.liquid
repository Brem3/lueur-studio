{% doc %}
Maps a finish/colour option value to a CSS colour for swatch backgrounds.
Falls back to a neutral gold if unknown.
@param {string} value - The option value (e.g. "Noir Mat", "Laiton Brossé")
@example
{% render 'swatch-color', value: 'Laiton Brossé' %}
{% enddoc %}
{%- liquid
  assign v = value | downcase
  if v contains 'noir'
    echo '#1A1A1A'
  elsif v contains 'laiton' or v contains 'doré' or v contains 'dore'
    echo '#C8A96E'
  elsif v contains 'anthracite'
    echo '#3A3A3A'
  elsif v contains 'sable'
    echo '#C4AA87'
  elsif v contains 'minuit'
    echo '#1C1C2E'
  elsif v contains 'terracotta'
    echo '#B85C3A'
  elsif v contains 'blanc'
    echo '#F0E8D8'
  else
    echo '#C8A96E'
  endif
-%}
