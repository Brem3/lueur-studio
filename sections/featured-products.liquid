<section class="section section--secondary">
  <div class="container">
    <div class="product-carousel__head reveal">
      <div class="section__head section__head--left">
        {% if section.settings.eyebrow != blank %}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2 class="section__title">{{ section.settings.title }}</h2>
      </div>
      <div class="product-carousel__nav">
        <button type="button" class="carousel-arrow" data-carousel-prev aria-label="{{ 'general.previous' | t }}">
          {% render 'icon', name: 'chevron-right' %}
        </button>
        <button type="button" class="carousel-arrow" data-carousel-next aria-label="{{ 'general.next' | t }}">
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    </div>

    <div class="product-carousel reveal" data-product-carousel>
      <div class="product-carousel__track" data-carousel-track>
        {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
          {% for product in section.settings.collection.products limit: section.settings.limit %}
            <div class="product-carousel__item">{% render 'product-card', product: product %}</div>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <div class="product-carousel__item">
              <div class="product-card">
                <div class="product-card__media">
                  {% render 'media', label: 'Lueur Studio', width: 800 %}
                </div>
                <div class="product-card__body">
                  <span class="product-card__title">{{ 'general.coming_soon' | t }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="section__head" style="margin-top:3rem;margin-bottom:0">
        <a href="{{ section.settings.cta_url }}" class="btn-secondary">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Produits en vedette",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Sélection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nos pièces signature"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre de produits",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Voir toute la collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du bouton"
    }
  ],
  "presets": [{ "name": "Produits en vedette" }]
}
{% endschema %}
