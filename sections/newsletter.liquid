<section class="section">
  <div class="container newsletter reveal">
    {% if section.settings.eyebrow != blank %}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2 style="">{{ section.settings.title }}</h2>
    <p>{{ section.settings.body }}</p>

    {% form 'customer' %}
      {% if form.posted_successfully? %}
        <p style="color:var(--color-success)">{{ 'newsletter.success' | t }}</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__form">
          <label class="visually-hidden" for="newsletter-email">{{ 'newsletter.email' | t }}</label>
          <input
            class="newsletter__input"
            type="email"
            id="newsletter-email"
            name="contact[email]"
            placeholder="{{ 'newsletter.placeholder' | t }}"
            autocomplete="email"
            required>
          <button type="submit" class="btn-primary">{{ 'newsletter.submit' | t }}</button>
        </div>
        {{ form.errors | default_errors }}
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Lettre Lueur"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Recevez nos idées d'aménagement"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Inspirations, conseils d'éclairage et offres en avant-première. Une à deux fois par mois, jamais plus."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
