<section class="section">
  <div class="container">
    <div class="guide-teaser reveal">
      <div class="guide-teaser__bg lamp-glow"></div>
      <div class="guide-teaser__content">
        {% if section.settings.eyebrow != blank %}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2 style="">{{ section.settings.title }}</h2>
        <p>{{ section.settings.body }}</p>
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_url }}" class="btn-primary" style="margin-top:1rem">{{ section.settings.cta_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Teaser guide d'achat",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Le guide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Quelle lumière pour quel extérieur ?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Solaire ou filaire, IP65 ou IP67, applique ou borne… Notre guide vous aide à choisir le luminaire parfait pour chaque espace, sans vous tromper."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Lire le guide d'achat"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du bouton"
    }
  ],
  "presets": [{ "name": "Teaser guide d'achat" }]
}
{% endschema %}
