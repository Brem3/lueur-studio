<section class="section">
  <div class="container">
    <div class="grid grid--3">
      <div class="reveal">
        <h3 style="font-style:italic;font-size:1.5rem">{{ 'product.info.shipping_title' | t }}</h3>
        <ul class="info-block" style="margin-top:1rem">
          <li>{% render 'icon', name: 'truck' %} {{ 'product.info.shipping_standard' | t }}</li>
          <li>{% render 'icon', name: 'bolt' %} {{ 'product.info.shipping_express' | t }}</li>
          <li>{% render 'icon', name: 'globe' %} {{ 'product.info.shipping_europe' | t }}</li>
        </ul>
        <a href="{{ section.settings.shipping_url }}" class="info-block link" style="display:inline-block;margin-top:1rem">{{ 'product.info.shipping_details' | t }} →</a>
      </div>
      <div class="reveal">
        <h3 style="font-style:italic;font-size:1.5rem">{{ 'product.info.returns_title' | t }}</h3>
        <ul class="info-block" style="margin-top:1rem">
          <li>{% render 'icon', name: 'return' %} {{ 'product.info.returns_30' | t }}</li>
          <li>{% render 'icon', name: 'shield' %} {{ 'product.info.warranty_2y' | t }}</li>
        </ul>
        <a href="{{ section.settings.returns_url }}" class="info-block link" style="display:inline-block;margin-top:1rem">{{ 'product.info.returns_details' | t }} →</a>
      </div>
      <div class="reveal">
        <h3 style="font-style:italic;font-size:1.5rem">{{ 'product.info.support_title' | t }}</h3>
        <ul class="info-block" style="margin-top:1rem">
          <li>{% render 'icon', name: 'headset' %} {{ 'product.info.support_chat' | t }}</li>
          <li>{% render 'icon', name: 'leaf' %} {{ 'product.info.support_french' | t }}</li>
        </ul>
        <a href="{{ section.settings.contact_url }}" class="info-block link" style="display:inline-block;margin-top:1rem">{{ 'product.info.contact' | t }} →</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Livraison & garantie",
  "settings": [
    { "type": "url", "id": "shipping_url", "label": "Lien livraison" },
    { "type": "url", "id": "returns_url", "label": "Lien retours" },
    { "type": "url", "id": "contact_url", "label": "Lien contact" }
  ],
  "presets": [{ "name": "Livraison & garantie" }]
}
{% endschema %}
