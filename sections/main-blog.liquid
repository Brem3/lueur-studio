<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <span class="section__eyebrow">{{ 'blog.eyebrow' | t }}</span>
      <h1 class="section__title">{{ blog.title }}</h1>
    </div>

    {% paginate blog.articles by 9 %}
      <div class="grid grid--3">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" class="article-card reveal">
            <div class="article-card__media">
              {% render 'media', image: article.image, label: article.title, width: 800, sizes: '(max-width: 640px) 100vw, 33vw' %}
            </div>
            <div class="article-card__meta">{{ article.published_at | date: '%d %B %Y' }}</div>
            <div class="article-card__title">{{ article.title }}</div>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </a>
        {% endfor %}
      </div>
      <div style="text-align:center;margin-top:3rem">{{ paginate | default_pagination }}</div>
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
