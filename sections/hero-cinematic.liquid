<section class="hero">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false }}
    {% else %}
      {% render 'media', image: section.settings.image, label: shop.name, width: 1800, loading: 'eager' %}
    {% endif %}
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__glow"></div>

  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>

  <a href="#main-scroll" class="hero__scroll" aria-label="{{ 'general.scroll' | t }}">
    {% render 'icon', name: 'chevron-down' %}
  </a>
</section>
<span id="main-scroll"></span>

{% schema %}
{
  "name": "Hero cinématique",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo de fond (prioritaire)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Maison française d'éclairage d'extérieur"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Révélez vos extérieurs après le coucher du soleil."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Des luminaires d'auteur qui transforment terrasses, jardins et allées en espaces habités, poétiques et premium."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir la collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du bouton"
    }
  ],
  "presets": [{ "name": "Hero cinématique" }]
}
{% endschema %}
