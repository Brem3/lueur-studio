<section class="section section--secondary">
  <div class="container">
    <div class="section__head reveal">
      {% if section.settings.eyebrow != blank %}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="section__title">{{ section.settings.title }}</h2>
    </div>

    <div class="grid grid--3">
      {% assign blog = blogs[section.settings.blog] %}
      {% if blog != blank and blog.articles_count > 0 %}
        {% for article in blog.articles limit: 3 %}
          <a href="{{ article.url }}" class="article-card reveal">
            <div class="article-card__media">
              {% render 'media', image: article.image, label: article.title, width: 800, sizes: '(max-width: 640px) 100vw, 33vw' %}
            </div>
            <div class="article-card__meta">{{ article.published_at | date: '%d %B %Y' }}</div>
            <div class="article-card__title">{{ article.title }}</div>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="article-card reveal">
            <div class="article-card__media">{% render 'media', label: 'Inspirations', width: 800 %}</div>
            <div class="article-card__title">{{ 'general.coming_soon' | t }}</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Articles à la une",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Inspirations"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Idées d'aménagement"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [{ "name": "Articles à la une" }]
}
{% endschema %}
