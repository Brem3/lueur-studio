<section class="section">
  <div class="container">
    <div class="section__head reveal"><h1 class="section__title">{{ 'cart.title' | t }}</h1></div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="page-content" style="max-width:900px">
        {% for item in cart.items %}
          <div style="display:flex;gap:1.25rem;align-items:center;padding:1.25rem 0;border-bottom:1px solid var(--color-border)">
            <a href="{{ item.url }}" style="width:90px;flex-shrink:0;aspect-ratio:1;border-radius:var(--border-radius-sm);overflow:hidden;display:block">
              {% render 'media', image: item.image, label: item.product.title, width: 200 %}
            </a>
            <div style="flex:1">
              <a href="{{ item.url }}" style="font-family:var(--font-display);font-size:1.25rem">{{ item.product.title }}</a>
              {% unless item.variant.title contains 'Default' %}
                <div style="font-size:var(--text-sm);color:var(--color-text-secondary)">{{ item.variant.title }}</div>
              {% endunless %}
            </div>
            <div style="display:flex;align-items:center;gap:1rem">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                style="width:64px;min-height:44px;background:var(--color-bg-card);border:1px solid var(--color-border);color:var(--color-text-primary);border-radius:var(--border-radius-sm);text-align:center">
              <span class="current" style="color:var(--color-gold);min-width:90px;text-align:right">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {% endfor %}

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:2rem;gap:1rem;flex-wrap:wrap">
          <button type="submit" name="update" class="btn-secondary">{{ 'cart.update' | t }}</button>
          <div style="text-align:right">
            <div style="font-family:var(--font-display);font-size:1.5rem;margin-bottom:1rem">
              {{ 'cart.subtotal' | t }} : <span style="color:var(--color-gold)">{{ cart.total_price | money }}</span>
            </div>
            <button type="submit" name="checkout" class="btn-primary">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="page-content" style="text-align:center">
        <p style="color:var(--color-text-secondary)">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary">{{ 'cart.continue' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "settings": []
}
{% endschema %}
