{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="section">
  <div class="container">
    <div class="product">
      <div class="product__gallery" data-gallery>
        <div class="product__gallery-main lamp-glow" data-gallery-main>
          {% if product.featured_media %}
            {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(max-width: 860px) 100vw, 55vw', widths: '600, 900, 1200, 1500' }}
          {% else %}
            {% render 'media', label: product.title, width: 1200, loading: 'eager' %}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="product__thumbs">
            {% for media in product.media limit: 5 %}
              <button
                type="button"
                class="product__thumb"
                data-gallery-thumb
                data-full="{{ media | image_url: width: 1200 }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'product.gallery.view' | t: index: forloop.index }}">
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product__info">
        {% render 'product-badge', product: product %}

        {%- assign rating = product.metafields.reviews.rating.value | default: 4.9 -%}
        {%- assign rcount = product.metafields.reviews.count.value | default: 87 -%}
        <a href="#reviews" style="display:inline-block;margin-top:0.75rem">
          {% render 'star-rating', rating: rating, count: rcount %}
        </a>

        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__price">
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="compare">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
          <span class="current" data-variant-price>{{ current_variant.price | money }}</span>
        </div>
        {% if section.settings.show_klarna %}
          <p class="product__klarna">{{ 'product.klarna' | t: amount: current_variant.price | divided_by: 3 | money }}</p>
        {% endif %}

        {% form 'product', product, data-product-form: '' %}
          <script type="application/json" data-variants-json>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "price": {{ variant.price | money | json }},
                  "image": {{ variant.featured_media.preview_image | image_url: width: 1200 | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {%- assign is_color = false -%}
              {%- assign oname = option.name | downcase -%}
              {%- if oname contains 'finition' or oname contains 'couleur' or oname contains 'color' -%}{%- assign is_color = true -%}{%- endif -%}
              <div class="product__option" data-option-group>
                <span class="product__option-label">{{ option.name }}</span>
                <input type="hidden" value="{{ option.selected_value }}">
                <div class="{% if is_color %}swatch-group{% else %}swatch-group{% endif %}" role="radiogroup" aria-label="{{ option.name }}">
                  {% for value in option.values %}
                    {%- assign checked = false -%}
                    {%- if value == option.selected_value -%}{%- assign checked = true -%}{%- endif -%}
                    {% if is_color %}
                      <button
                        type="button"
                        class="swatch"
                        data-option-value="{{ value | escape }}"
                        role="radio"
                        aria-checked="{{ checked }}"
                        title="{{ value }}"
                        style="background:{% render 'swatch-color', value: value %}"></button>
                    {% else %}
                      <button
                        type="button"
                        class="variant-btn"
                        data-option-value="{{ value | escape }}"
                        role="radio"
                        aria-checked="{{ checked }}">{{ value }}</button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <div class="product__qty">
            <label class="product__option-label" for="qty" style="margin:0">{{ 'product.quantity' | t }}</label>
            <select id="qty" name="quantity">
              {% for i in (1..10) %}<option value="{{ i }}">{{ i }}</option>{% endfor %}
            </select>
          </div>

          <button type="submit" name="add" class="btn-primary btn-full" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}
              <span data-add-label data-add-prefix="{{ 'product.add_to_cart' | t }}">{{ 'product.add_to_cart' | t }} — {{ current_variant.price | money }}</span>
            {% else %}
              {{ 'product.sold_out' | t }}
            {% endif %}
          </button>

          {{ form | payment_button }}
        {% endform %}

        <ul class="product__usp">
          <li>{% render 'icon', name: 'check' %} {{ 'product.usp.shipping' | t }}</li>
          <li>{% render 'icon', name: 'check' %} {{ 'product.usp.returns' | t }}</li>
        </ul>

        <div class="product__reassurance">
          <div>{% render 'icon', name: 'truck' %} {{ 'product.delivery_estimate' | t }}</div>
          <div>{% render 'icon', name: 'shield' %} {{ 'product.guarantee_line' | t }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produit",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_klarna",
      "label": "Afficher le paiement en 3x",
      "default": true
    }
  ]
}
{% endschema %}
