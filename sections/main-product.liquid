{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="section section--product">
  <div class="container">
    <div class="product">
      <div class="product__gallery product__gallery--sticky" data-gallery>
        {%- assign main_image = current_variant.featured_media.preview_image | default: product.featured_image -%}
        <div class="product__gallery-main lamp-glow" data-gallery-main>
          {% if main_image %}
            {{ main_image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(max-width: 860px) 100vw, 55vw', widths: '600, 900, 1200, 1500' }}
          {% else %}
            {% render 'media', label: product.title, width: 1200, loading: 'eager' %}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="product__thumbs">
            {% for media in product.media limit: 5 %}
              <button
                type="button"
                class="product__thumb"
                data-gallery-thumb
                data-full="{{ media | image_url: width: 1200 }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'product.gallery.view' | t: index: forloop.index }}">
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product__info">
        {% render 'product-badge', product: product %}

        {%- assign rating = product.metafields.reviews.rating.value | default: 4.9 -%}
        {%- assign rcount = product.metafields.reviews.count.value | default: 87 -%}
        <a href="#reviews" style="display:inline-block;margin-top:0.75rem">
          {% render 'star-rating', rating: rating, count: rcount %}
        </a>

        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__price">
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="compare">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
          <span class="current" data-variant-price>{{ current_variant.price | money }}</span>
        </div>

        {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
        {% if feature_blocks.size > 0 %}
          <ul class="product__features">
            {% for block in feature_blocks %}
              <li class="product__feature" {{ block.shopify_attributes }}>
                <span class="product__feature-icon">{% render 'icon', name: block.settings.icon %}</span>
                <span class="product__feature-text">{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% form 'product', product, data-product-form: '' %}
          <script type="application/json" data-variants-json>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "price": {{ variant.price | money | json }},
                  "image": {{ variant.featured_media.preview_image | image_url: width: 1200 | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {%- assign is_color = false -%}
              {%- assign oname = option.name | downcase -%}
              {%- if oname contains 'couleur' or oname contains 'finition' or oname contains 'color' -%}{%- assign is_color = true -%}{%- endif -%}
              <div class="product__option" data-option-group>
                <span class="product__option-label">{{ option.name }} : <strong class="product__option-current" data-option-current>{{ option.selected_value }}</strong></span>
                <input type="hidden" value="{{ option.selected_value }}">
                <div class="{% if is_color %}swatch-group{% else %}variant-group{% endif %}" role="radiogroup" aria-label="{{ option.name }}">
                  {% for value in option.values %}
                    {%- assign checked = false -%}
                    {%- if value == option.selected_value -%}{%- assign checked = true -%}{%- endif -%}
                    {% if is_color %}
                      <button
                        type="button"
                        class="swatch"
                        data-option-value="{{ value | escape }}"
                        role="radio"
                        aria-checked="{{ checked }}"
                        title="{{ value }}"
                        aria-label="{{ value }}"
                        style="--swatch:{% render 'swatch-color', value: value %}"><span class="swatch__dot"></span><span class="swatch__label">{{ value }}</span></button>
                    {% else %}
                      <button
                        type="button"
                        class="variant-btn"
                        data-option-value="{{ value | escape }}"
                        role="radio"
                        aria-checked="{{ checked }}">{{ value }}</button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- assign bundle_products = section.settings.bundle_products -%}
          {% if bundle_products.count > 0 %}
            <div class="product-bundle" data-bundle>
              {% if section.settings.bundle_title != blank %}
                <p class="product-bundle__title">{{ section.settings.bundle_title }}</p>
              {% endif %}
              {% for bp in bundle_products %}
                {%- assign bv = bp.selected_or_first_available_variant -%}
                {% if bv %}
                  <label class="bundle-item" data-bundle-item>
                    <input
                      type="checkbox"
                      class="bundle-item__check"
                      data-bundle-variant="{{ bv.id }}"
                      checked>
                    <span class="bundle-item__box" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
                    <span class="bundle-item__media">
                      {% if bp.featured_image %}
                        {{ bp.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: bp.title }}
                      {% endif %}
                    </span>
                    <span class="bundle-item__info">
                      <span class="bundle-item__name">{{ bp.title }}</span>
                      <span class="bundle-item__price">
                        <span class="bundle-item__now">{{ bv.price | money }}</span>
                        {% if bv.compare_at_price > bv.price %}
                          <span class="bundle-item__was">{{ bv.compare_at_price | money }}</span>
                        {% endif %}
                      </span>
                    </span>
                  </label>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          <div class="product__qty">
            <label class="product__option-label" for="qty" style="margin:0">{{ 'product.quantity' | t }}</label>
            <select id="qty" name="quantity">
              {% for i in (1..10) %}<option value="{{ i }}">{{ i }}</option>{% endfor %}
            </select>
          </div>

          <button type="submit" name="add" class="btn-primary btn-full" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}
              <span data-add-label data-add-prefix="{{ 'product.add_to_cart' | t }}">{{ 'product.add_to_cart' | t }} — {{ current_variant.price | money }}</span>
            {% else %}
              {{ 'product.sold_out' | t }}
            {% endif %}
          </button>

          {{ form | payment_button }}
        {% endform %}
        <span data-atc-anchor aria-hidden="true"></span>

      </div>
    </div>
  </div>
</section>

{%- comment -%} Barre add-to-cart flottante (inspirée Neutralighting) {%- endcomment -%}
<div class="float-atc" data-float-atc>
  <div class="container float-atc__inner">
    <div class="float-atc__info">
      {%- assign atc_image = current_variant.featured_media.preview_image | default: product.featured_image -%}
      {% if atc_image %}
        <div class="float-atc__thumb">
          {{ atc_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
        </div>
      {% endif %}
      <div class="float-atc__meta">
        <span class="float-atc__title">{{ product.title }}</span>
        <span class="float-atc__price" data-variant-price>{{ current_variant.price | money }}</span>
      </div>
    </div>
    <div class="float-atc__cta">
      <button type="button" class="btn-primary" data-float-atc-button {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Produit",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_klarna",
      "label": "Afficher le paiement en 3x",
      "default": true
    },
    {
      "type": "header",
      "content": "Bundle / ventes croisées"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Titre du bundle",
      "default": "Bundle -15% accessoires"
    },
    {
      "type": "product_list",
      "id": "bundle_products",
      "label": "Produits du bundle",
      "limit": 4,
      "info": "Cochés par défaut, ajoutés au panier avec le produit principal."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Point clé (grille)",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "check",
          "options": [
            { "value": "check", "label": "Coche" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "bolt", "label": "Éclair" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "truck", "label": "Camion" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "globe", "label": "Globe" },
            { "value": "headset", "label": "Casque audio" },
            { "value": "calendar", "label": "Calendrier" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Décrivez un avantage clé du produit."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Produit",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
