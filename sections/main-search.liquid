<section class="section">
  <div class="container">
    <div class="section__head reveal"><h1 class="section__title">{{ 'search.title' | t }}</h1></div>

    <form action="{{ routes.search_url }}" method="get" class="newsletter__form" style="margin:0 auto 3rem">
      <label class="visually-hidden" for="search-input">{{ 'search.title' | t }}</label>
      <input type="search" id="search-input" name="q" value="{{ search.terms | escape }}" class="newsletter__input" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="btn-primary">{% render 'icon', name: 'search' %}</button>
    </form>

    {% if search.performed %}
      {% if search.results.size > 0 %}
        <p style="text-align:center;color:var(--color-text-secondary);margin-bottom:2rem">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
        {% paginate search.results by 12 %}
          <div class="grid grid--3">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% render 'product-card', product: item %}
              {% else %}
                <a href="{{ item.url }}" class="article-card reveal">
                  <div class="article-card__title">{{ item.title }}</div>
                  <p class="article-card__excerpt">{{ item.content | default: item.excerpt | strip_html | truncate: 120 }}</p>
                </a>
              {% endif %}
            {% endfor %}
          </div>
          <div style="text-align:center;margin-top:3rem">{{ paginate | default_pagination }}</div>
        {% endpaginate %}
      {% else %}
        <p style="text-align:center;color:var(--color-text-secondary)">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
