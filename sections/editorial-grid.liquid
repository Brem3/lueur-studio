<section class="section editorial-grid">
  <div class="container">
    {% if section.settings.heading != blank %}
      <div class="editorial-grid__intro reveal">
        {% if section.settings.eyebrow != blank %}
          <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="editorial-grid__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.intro_cta_label != blank %}
          <a href="{{ section.settings.intro_cta_url }}" class="btn-primary editorial-grid__intro-cta">{{ section.settings.intro_cta_label }}</a>
        {% endif %}
      </div>
    {% endif %}

    <div class="editorial-grid__grid">
      {% for block in section.blocks %}
        <article class="edcard reveal" {{ block.shopify_attributes }}>
          <div class="edcard__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 50vw, 25vw', widths: '400, 600, 800', alt: block.settings.title, class: 'edcard__img' }}
            {% elsif block.settings.image_url != blank %}
              <img class="edcard__img" src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}" loading="lazy" width="800">
            {% else %}
              {% render 'media', label: block.settings.title, width: 600 %}
            {% endif %}
            <div class="edcard__overlay"></div>
            <h3 class="edcard__title">{{ block.settings.title }}</h3>
            {% if block.settings.description != blank %}
              <div class="edcard__hover">
                <p class="edcard__hover-desc">{{ block.settings.description }}</p>
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="editorial-grid__cta">
        <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Grille éditoriale",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Titre de section",
      "info": "Utilisez <em>…</em> pour un mot en serif italique accent.",
      "default": "Chaque extérieur mérite <em>sa lumière</em>."
    },
    {
      "type": "text",
      "id": "intro_cta_label",
      "label": "Bouton sous le titre"
    },
    {
      "type": "url",
      "id": "intro_cta_url",
      "label": "Lien bouton sous le titre"
    },
    {
      "type": "header",
      "content": "Bouton bas de section"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir la collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "URL image (CDN)"
        },
        {
          "type": "html",
          "id": "title",
          "label": "Titre",
          "info": "Utilisez <em>…</em> pour un mot en serif italique.",
          "default": "Voir, vivre, <em>éclairer</em>"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Une lumière pensée pour sublimer chaque recoin de vos extérieurs."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Grille éditoriale",
      "blocks": [
        { "type": "card", "settings": { "title": "Voir, vivre, <em>éclairer</em>", "description": "Une lumière pensée pour sublimer chaque recoin de vos extérieurs." } },
        { "type": "card", "settings": { "title": "Idéal pour <em>les terrasses</em>", "description": "Des ambiances chaleureuses qui prolongent vos soirées d'été." } },
        { "type": "card", "settings": { "title": "Résiste à <em>tout temps</em>", "description": "Certifié IP65 : pluie, gel et chaleur n'altèrent rien." } },
        { "type": "card", "settings": { "title": "Pensé pour <em>l'extérieur</em>", "description": "Solaire ou filaire, une solution pour chaque jardin." } }
      ]
    }
  ]
}
{% endschema %}
